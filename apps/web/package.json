{
  "name": "@mist-service/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-budget.mjs",
    "complexity-ratchet": "node scripts/check-complexity-ratchet.mjs",
    "contract:openapi": "node scripts/check-openapi-contract.mjs",
    "dead-code": "knip --include files,exports,dependencies,unlisted,binaries && knip --production --include exports",
    "format": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/**/*.{js,mjs,ts}\" \"*.{js,ts,json}\" ../../.prettierrc.json",
    "format:check": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/**/*.{js,mjs,ts}\" \"*.{js,ts,json}\" ../../.prettierrc.json",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-router": "^8.3.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "knip": "6.32.0",
    "prettier": "3.9.6",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
