# Copy to .env for local development. Replace every CHANGE_ME value.
# The shared demo password is deliberately weak and must never leave local/test.
ENVIRONMENT=local
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
APP_DATABASE_NAME=istari_service
APP_DATABASE_USER=istari_service
APP_DATABASE_PASSWORD=CHANGE_ME
APP_RUNTIME_DATABASE_USER=istari_runtime
APP_RUNTIME_DATABASE_PASSWORD=CHANGE_ME
APP_BACKUP_DATABASE_USER=istari_backup
APP_BACKUP_DATABASE_PASSWORD=CHANGE_ME
CAMUNDA_DATABASE_NAME=camunda_secondary
CAMUNDA_DATABASE_USER=camunda
CAMUNDA_DATABASE_PASSWORD=CHANGE_ME
MIGRATION_DATABASE_URL=postgresql+asyncpg://istari_service:CHANGE_ME@postgres:5432/istari_service
DATABASE_URL=postgresql+asyncpg://istari_runtime:CHANGE_ME@postgres:5432/istari_service
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
WORKER_DATABASE_POOL_SIZE=5
WORKER_DATABASE_MAX_OVERFLOW=5
CAMUNDA_REST_ADDRESS=http://orchestration:8080
CAMUNDA_AUTH_MODE=NONE
CAMUNDA_PROCESS_ID=service-request-v1
CAMUNDA_USERNAME=
CAMUNDA_PASSWORD=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=istari_session
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=28800
SESSION_IDLE_SECONDS=3600
ADMIN_ELEVATION_SECONDS=300
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_PER_SOURCE=30
LOGIN_RATE_LIMIT_GLOBAL=300
LOGIN_RATE_LIMIT_TIMEOUT_SECONDS=3
LOGIN_HASH_CONCURRENCY=2
# Set only to the exact ingress proxy networks that overwrite X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
WEB_ORIGIN=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,api
MAX_REQUEST_BODY_BYTES=1048576
PRODUCT_STORAGE_PATH=/var/lib/istari-products
PRODUCT_ALLOWED_EXTERNAL_DOMAINS=products.example.test
PRODUCT_UPLOAD_TTL_SECONDS=600
PRODUCT_MAX_FILE_BYTES=26214400
PRODUCT_MAX_PACKAGE_BYTES=104857600
PRODUCT_CLAMAV_HOST=clamav
PRODUCT_CLAMAV_PORT=3310
PRODUCT_CLAMAV_TIMEOUT_SECONDS=30
CLAMAV_SIGNATURE_MAX_AGE_HOURS=48
ACTION_WORKSPACE_ENABLED=true
NOTIFICATIONS_ENABLED=true
MANAGED_PRODUCTS_ENABLED=true
MANAGED_FILE_UPLOADS_ENABLED=true
CONFIGURATION_ADMIN_ENABLED=true
PLANNING_EVOLUTION_ENABLED=true
STATISTICS_EVOLUTION_ENABLED=true
WORKER_HEALTH_REQUIRED=true
WORKER_INTERVAL_SECONDS=0.5
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_STALE_SECONDS=10
REQUEST_MATCHING_SEMANTIC_ENABLED=true
REQUEST_EMBEDDING_THREADS=2
REQUEST_EMBEDDING_BATCH_SIZE=8
ALLOW_DEMO_USERS=true
DEMO_USER_PASSWORD=admin
AUDIT_HMAC_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS
